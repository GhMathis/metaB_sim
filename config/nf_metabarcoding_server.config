// Site configuration for running nf-metabarcoding on the analysis server
// (mgheno@194.254.138.192). Passed with -c by scripts/05_run_nf_metabarcoding.sh,
// on top of the pipeline defaults and the selected profiles; this is the
// pipeline's documented way to adapt it to a machine (conf/site.config.example
// in the pipeline repository), instead of editing its nextflow.config.

// The server is shared: cap what the local executor may use at once, across
// all concurrent tasks. Each task asks for params.threads cores
// (config/nf_metabarcoding_params.yml).
executor {
    name   = 'local'
    cpus   = 8
    memory = 32.GB
}
